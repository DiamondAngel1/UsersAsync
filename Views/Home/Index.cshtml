@model List<MyMvcApp.Data.User>

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Мій перший сайт</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-rbsA2VBKQhggwzxH7pPCaAqO46MgnOM80zW1RWuH61DGLwZJEdK2Kadq2F9CUG65" crossorigin="anonymous">
</head>

<body>
    <h1 class="text-center-bold">Користувачі</h1>
    <div class="container">
        <a href="@Url.Action("Create")" class="btn btn-success">Додати</a>

        <table class="table">
            <thead>
                <tr>
                    <th scope="col">#</th>
                    <th scope="col">Фото</th>
                    <th scope="col">Назва</th>
                    <th scope="col">Телефон</th>
                    <th scope="col">Стать</th>
                </tr>
            </thead>
            <tbody>
                @foreach(var user in Model){
                    string image;
                    if (!string.IsNullOrEmpty(user.Image) && user.Image.StartsWith("http")){
                        image = user.Image;
                    }
                    else if (!string.IsNullOrEmpty(user.Image)){
                        image = Url.Content("~/images/" + user.Image);
                    }
                    else{
                        image = "https://t4.ftcdn.net/jpg/01/86/29/31/360_F_186293166_P4yk3uXQBDapbDFlR17ivpM6B1ux0fHG.jpg";
                    }
                    <tr>
                        <td>@user.Id</td>
                        <td>
                            <img src=@image width="80" />
                        </td>
                        <td>@user.LastName @user.FirstName</td>
                        <td>@user.Phone</td>
                        <td>@(user.Sex ? "Чоловік" : "Жінка")</td>
                    </tr>
                } 
            </tbody>
        </table>
    </div>

</body>
<style>
    body {
        background-image: url('https://oir.mobi/uploads/posts/2021-03/1616578392_27-p-svetlii-fon-dlya-saita-28.jpg');
        background-size: contain;
    }
    h1{
        text-align:center;
        margin-top: 50px;
    }

    .btn {
        background-image: radial-gradient(100% 100% at 100% 0, #5adaff 0, #5468ff 100%);
        border: 0;
        border-radius: 6px;
        box-shadow: rgba(45, 35, 66, .4) 0 2px 4px,rgba(45, 35, 66, .3) 0 7px 13px -3px,rgba(58, 65, 111, .5) 0 -3px 0 inset;
        padding-left: 30px;
        padding-right: 30px;
        transition: box-shadow .15s,transform .15s;
        font-size: 18px;
        height: 40px;
        color: white;
        margin-bottom: 21px;
    }

    .btn:focus {
        box-shadow: #3c4fe0 0 0 0 1.5px inset, rgba(45, 35, 66, .4) 0 2px 4px, rgba(45, 35, 66, .3) 0 7px 13px -3px, #3c4fe0 0 -3px 0 inset;
    }

    .btn:hover {
        box-shadow: rgba(45, 35, 66, .4) 0 4px 8px, rgba(45, 35, 66, .3) 0 7px 13px -3px, #3c4fe0 0 -3px 0 inset;
        transform: translateY(-2px);
    }

    .btn:active {
        box-shadow: #3c4fe0 0 3px 7px inset;
        transform: translateY(2px);
    }
    .table{
        background-color: rgba(255, 255, 255, 0.2);
        backdrop-filter: blur(5px);
        border: 2px solid #3c4fe0;
    }
    .container{
        padding: 10%;
        padding-top: 0;
    }
</style>
</html>
